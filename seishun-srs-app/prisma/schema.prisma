generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  role         Role           @default(USER)
  createdAt    DateTime       @default(now())
  sessions     Session[]
  progress     UserProgress[]
  reviewLogs   ReviewLog[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Novel {
  id           Int          @id @default(autoincrement())
  slug         String       @unique
  title        String
  coverImage   String?
  sortOrder    Int          @default(0)
  vocabEntries VocabEntry[]
}

model VocabEntry {
  id            Int               @id @default(autoincrement())
  kanji         String?
  kana          String
  meaning       String
  occurrences   Int               @default(0)
  novelId       Int               @default(1)
  novel         Novel             @relation(fields: [novelId], references: [id])
  jmdictId      Int?
  jlptLevel     String?
  partsOfSpeech String[]
  allReadings   String[]
  allMeanings   String[]
  tags          String[]
  blacklisted   Boolean           @default(false)
  sentences     ExampleSentence[]
  progress      UserProgress[]
  reviewLogs    ReviewLog[]
}

model ExampleSentence {
  id           Int        @id @default(autoincrement())
  japaneseText String
  englishTrans String
  vocabId      Int
  vocab        VocabEntry @relation(fields: [vocabId], references: [id])
}

model UserProgress {
  id             Int        @id @default(autoincrement())
  userId         String?
  user           User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  easeFactor     Float      @default(2.5)
  interval       Int        @default(0)
  repetitions    Int        @default(0)
  nextReviewDate DateTime   @default(now())
  lastReviewDate DateTime?
  totalReviews   Int        @default(0)
  vocabId        Int
  vocab          VocabEntry @relation(fields: [vocabId], references: [id])

  @@unique([userId, vocabId])
}

model ReviewLog {
  id         Int        @id @default(autoincrement())
  userId     String?
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabId    Int
  grade      Int
  reviewedAt DateTime   @default(now())
  vocab      VocabEntry @relation(fields: [vocabId], references: [id])
}

model KanjiEntry {
  character   String   @id
  onyomi      String[]
  kunyomi     String[]
  meanings    String[]
  strokeCount Int?
  jlptLevel   String?
  grade       Int?
  frequency   Int?
}
